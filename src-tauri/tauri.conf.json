{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oatmeal",
  "version": "0.1.0",
  "identifier": "com.kaichen.oatmeal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Oatmeal",
        "width": 1100,
        "height": 980,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/oatmeal-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/c-wenlong/oatmeal/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE3NzE2RkUwOTU1NzRENzkKUldSNVRWZVY0Rzl4cHpqS3N5Qjc5NWE3RXVFRnpxWkR5NmR4ZXJ4OGppVmtwT1pOTWppbE91RHYK"
    }
  }
}
